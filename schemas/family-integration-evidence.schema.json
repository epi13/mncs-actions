{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-actions/blob/main/schemas/family-integration-evidence.schema.json",
  "title": "MNCS Actions family integration evidence",
  "description": "Public v2 evidence contract for a fixed or moving-head family observation. The six family revisions, producer/check membership, exact bytes, explicit authority roles, bounded execution topology, typed provenance bindings, and development-pressure lifecycle are explicit. Runtime validation additionally compares membership, role projections, revisions, and binding relationships against the executed descriptors and contracts.",
  "type": "object",
  "required": [
    "schema_version", "mode", "contract_document", "contract_digest",
    "descriptor_document", "descriptor_digest", "family_revisions", "checks",
    "provenance_bindings", "unresolved_obligations", "authority", "promotion", "execution",
    "development_pressure", "observation"
  ],
  "properties": {
    "schema_version": { "const": "mncs-actions.family-integration-evidence/2" },
    "mode": { "enum": ["fixed", "moving-head"] },
    "contract_document": { "$ref": "#/$defs/safePath" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "descriptor_document": { "$ref": "#/$defs/safePath" },
    "descriptor_digest": { "$ref": "#/$defs/digest" },
    "family_revisions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": { "$ref": "#/$defs/familyRevision" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/check" }
    },
    "provenance_bindings": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/provenanceBinding" }
    },
    "unresolved_obligations": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/unresolved" }
    },
    "authority": {
      "type": "object",
      "required": ["mncs", "mncds", "commons", "rights", "language", "forge", "orchestration"],
      "properties": {
        "mncs": { "type": "string", "minLength": 1 },
        "mncds": { "type": "string", "minLength": 1 },
        "commons": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "forge": { "type": "string", "minLength": 1 },
        "orchestration": { "const": "mncs-actions" }
      },
      "additionalProperties": false
    },
    "promotion": { "const": "observation-only; this document cannot update family-contracts.json" },
    "execution": {
      "type": "object",
      "required": ["protocol", "producer_jobs", "aggregator_executes_producer_code", "artifact_transport", "candidate_isolation"],
      "properties": {
        "protocol": { "const": "mncs-actions.family-producer-output/2" },
        "producer_jobs": { "const": true },
        "aggregator_executes_producer_code": { "const": false },
        "artifact_transport": { "const": "content-addressed" },
        "candidate_isolation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "development_pressure": {
      "type": "object",
      "required": ["path", "digest", "obligation_count", "not_reproduced_count"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "obligation_count": { "type": "integer", "minimum": 0 },
        "not_reproduced_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["observation_id", "kind", "resolution_status", "semantic_resolution_authority", "promotion_status"],
      "properties": {
        "observation_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "kind": { "const": "family-evaluation" },
        "resolution_status": { "const": "NOT_ESTABLISHED" },
        "semantic_resolution_authority": { "type": "string", "minLength": 1 },
        "promotion_status": { "const": "INDEPENDENT_REVIEW_REQUIRED" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!^[A-Za-z]:)(?!.*(^|/)(?:\\.|\\.\\.)(/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    },
    "familyRevision": {
      "type": "object",
      "required": ["repository", "branch", "revision"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "branch": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "provider", "evidence_provider", "semantic_authority", "remediation_owner", "transport_authority", "originating_project", "producer", "producer_revision", "contract_revision", "verdict", "path", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "evidence_provider": { "type": "string", "minLength": 1 },
        "semantic_authority": { "type": "string", "minLength": 1 },
        "remediation_owner": { "type": "string", "minLength": 1 },
        "transport_authority": { "const": "mncs-actions" },
        "originating_project": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "producer_revision": { "$ref": "#/$defs/sha" },
        "contract_revision": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "path": { "$ref": "#/$defs/safePath" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": ["obligation_key", "pressure_id", "check_id", "owner", "evidence_provider", "semantic_authority", "remediation_owner", "transport_authority", "originating_project", "producer", "producer_revision", "category", "claim", "current_limitation", "lifecycle"],
      "properties": {
        "obligation_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pressure_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "check_id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "evidence_provider": { "type": "string", "minLength": 1 },
        "semantic_authority": { "type": "string", "minLength": 1 },
        "remediation_owner": { "type": "string", "minLength": 1 },
        "transport_authority": { "const": "mncs-actions" },
        "originating_project": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "producer_revision": { "$ref": "#/$defs/sha" },
        "category": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "current_limitation": { "type": "string", "minLength": 1 },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "reproduction", "resolution_status", "semantic_resolution", "promotion_status", "correlation_key"],
      "properties": {
        "state": { "const": "OPEN" },
        "reproduction": { "enum": ["NEW", "REPRODUCED"] },
        "resolution_status": { "const": "NOT_ESTABLISHED" },
        "semantic_resolution": { "const": "NOT_ESTABLISHED" },
        "promotion_status": { "const": "INDEPENDENT_REVIEW_REQUIRED" },
        "correlation_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "provenanceBinding": {
      "type": "object",
      "required": ["producer", "kind", "authority", "path", "sha256", "authority_status", "revision"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "authority_status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "revision": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
