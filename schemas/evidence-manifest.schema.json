{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-actions/blob/main/schemas/evidence-manifest.schema.json",
  "title": "MNCS Evidence Manifest",
  "description": "The experimental v1 manifest emitted by mncs-actions when a verification/aggregation claim is ESTABLISHED. Additive v1 clarification: kind now permits verification, check, or aggregation; optional receipt, references, claim_status, unresolved, and boundary fields carry execution/receipt and family-reference plumbing without changing required fields. No manifest is emitted when the claim is NOT_ESTABLISHED; a valid execution-receipt is emitted instead.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "verdict",
    "result",
    "provenance",
    "command_exit_code",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "mncs.evidence-manifest/1"
    },
    "kind": {
      "enum": ["verification", "check", "aggregation"]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "result": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "ref": { "type": "string" },
        "commit": { "type": "string" },
        "workflow": { "type": "string" },
        "run_id": { "type": "string" },
        "actor": { "type": "string" },
        "event": { "type": "string" },
        "runner": { "type": "string" }
      },
      "additionalProperties": true
    },
    "command_exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_status": {
      "const": "ESTABLISHED",
      "description": "Manifests only exist for established claims. Absence implies ESTABLISHED for compatibility."
    },
    "receipt": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": true,
      "description": "Reference to the sibling execution-receipt.json in the same evidence directory."
    },
    "references": {
      "type": "array",
      "description": "Generic family-owned evidence references carried without redefining their meaning.",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "producer": { "type": "string" },
          "contract_revision": { "type": "string" },
          "schema_revision": { "type": "string" },
          "producer_revision": { "type": "string" },
          "path": { "type": "string" },
          "uri": { "type": "string" },
          "digest": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
