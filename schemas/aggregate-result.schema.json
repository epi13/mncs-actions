{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-actions/blob/main/schemas/aggregate-result.schema.json",
  "title": "MNCS Aggregate Result",
  "description": "Composed verdict over independent check-results. Dominance is FAIL > UNKNOWN > PASS over required checks. Optional UNKNOWN stays visible in unresolved and never silently decides the boundary.",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "required",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "mncs.aggregate-result/1"
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "UNKNOWN"]
    },
    "summary": {
      "type": "string"
    },
    "required": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "optional": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
          "required": { "type": "boolean" },
          "provider": { "type": "string" },
          "scope": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
