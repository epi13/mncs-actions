{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-actions/blob/main/schemas/family-producer-output.schema.json",
  "title": "MNCS Actions family producer output",
  "description": "Content-addressed transport envelope emitted by one bounded producer job. It has no aggregation or promotion authority.",
  "type": "object",
  "required": ["schema_version", "mode", "producer", "repository", "revision", "descriptor_digest", "files", "check_results"],
  "properties": {
    "schema_version": { "const": "mncs-actions.family-producer-output/1" },
    "mode": { "enum": ["fixed", "moving-head"] },
    "producer": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "descriptor_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "sha256": { "$ref": "#/$defs/digest" },
          "kind": { "enum": ["native", "check-result"] }
        },
        "additionalProperties": false
      }
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/safePath" },
          "sha256": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!^[A-Za-z]:)(?!.*(^|/)(?:\\.|\\.\\.)(/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    }
  },
  "additionalProperties": false
}
