mncs 0.9;

// Fixture: self-contained arithmetic contract for the actions provider test.
// No imports: runs anywhere an mncs binary exists.
module fixtures.semantic_smoke;

fn add(a: i64, b: i64) -> (result: i64)
    property prop_roundtrip
{
    return a +% b;
}

fn sub(a: i64, b: i64) -> (result: i64) {
    return a -% b;
}

fn prop_roundtrip(x: i64, y: i64) -> (result: bool) {
    return sub(add(x, y), y) == x;
}
