{
  "schema_version": "mncs-family.repository-manifest/v0alpha1",
  "repository": "mncs-actions",
  "revision": 2,
  "manifest_location": "in-repository",
  "authority": {
    "note": "Actions owns transport, family verification orchestration, evidence envelopes, and provider routing; test/debug/language semantics remain with their owners."
  },
  "organization": {
    "layout": "mncs.repository-layout/1",
    "surfaces": [
      {"path": "pressure/", "class": "canonical", "authority": "mncs-actions", "note": "Native pressure/evidence kernels."},
      {"path": "scripts/", "class": "host-boundary", "note": "Transport, workflow, and external process adapters; the selective verifier remains a temporary semantic implementation below."},
      {"path": "scripts/selective_family_verify.py", "class": "compatibility", "authority": "mncs-actions", "note": "Explicit compatibility transport adapter over the native Actions semantic authority; retained for external process, filesystem, and JSON publication boundaries.", "classification": {"authority": "compatibility", "lifecycle": "active", "boundary_kind": "process", "semantic_role": "compatibility-adapter"}},
      {"path": "native/mncs/actions/", "class": "canonical", "authority": "mncs-actions", "note": "Native family admission, receipt reuse, traversal, aggregation, and proof composition are canonical here.", "classification": {"authority": "canonical", "lifecycle": "active", "boundary_kind": "none", "semantic_role": "canonical-semantic"}}
    ]
  },
  "contracts": {
    "provides": [
      {"contract": "family-verification", "version": "1", "kind": "evidence-automation", "stability": "experimental", "fingerprint_sources": ["native/mncs/actions/", "scripts/", "pressure/", "schemas/"]}
    ],
    "consumes": [
      {"contract": "mncs-test.test-provider", "envelope": {"op": "any"}, "required": true},
      {"contract": "mncs-debug.debugger", "envelope": {"op": "any"}, "required": false},
      {"contract": "mncs-commons.pressure-registry", "envelope": {"op": "any"}, "required": false}
    ],
    "tests": [
      {"test": "actions-tests", "covers": ["family-verification"], "obligation": "self", "command": {"argv": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"]}}
    ]
  }
}
